@startuml flowfield-uml
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam activityBackgroundColor #EEF5FB
skinparam activityBorderColor #496A88
skinparam ArrowColor #496A88
skinparam Padding 8
title FlowField - core flow

start
:FlowFieldManager\nAccept / coalesce latest request;
if (Space mode?) then (Surface2D)
  :Manager.LateUpdate Submit\nBuildDriver pumps FlowFieldSession;
else (Volume3D)
  :BuildDriver.LateUpdate\nBuildScheduler.PumpAll;
endif
:Session prepares navigation\nor loads a v6 bake;
:Compose Default Direction\nand Modifier snapshots;
:Publish complete result\nFieldStore / VolumeFieldData;
:IFlowFieldProvider.TrySample(position);
if (Sample has usable\ndirection and speed?) then (move)
  :Apply direction * base speed\n* SpeedMultiplier;
else (stop)
  :Apply zero velocity;
endif
stop
@enduml

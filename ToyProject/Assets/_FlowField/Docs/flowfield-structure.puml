@startuml flowfield-structure
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName "Apple SD Gothic Neo"
skinparam defaultFontSize 15
skinparam ArrowColor #496A88
skinparam Padding 6
skinparam classBackgroundColor #EEF5FB
skinparam classBorderColor #496A88
hide empty members
hide circle
title FlowField 구조

class "FlowFieldDynamicObstacle\nFlowFieldGoalTarget\nModifier Volume" as Components {
  변경을 스스로 통지
}
interface "IFlowFieldController" as API
class FlowFieldManager {
  직렬화 설정·공개 API
}
class FlowFieldSpaceStrategy {
  모드별 Session 생성·검증·격자·Bounds 맞춤
}
class "FlowFieldSession\n(공통 파이프라인)" as Session {
  수명·상태·이벤트·빌드 루프
  장애물·Modifier 등록부
  {field} 불확실 영역(FlowFieldSafety)
  샘플 안전 규칙
}
interface IFlowFieldSpaceBuilder {
  빌드 단계·게시 필드
  최신 셀 정보·수명 훅
}
class FlowFieldSurfaceBuilder {
  Surface2D 계산
}
class FlowFieldVolumeBuilder {
  Volume3D 계산
}
class FlowFieldBuildScheduler {
  모든 Session에 프레임당 공통 예산
}
class FlowFieldExecutionBoundary {
  이벤트·Modifier 명령을 작업 뒤로
}
class "Editor\n(BakeService·BakeEditor)" as Editor {
  Bake·미리보기
}

Components ..> API : 통지
FlowFieldManager ..|> API
FlowFieldManager --> FlowFieldSpaceStrategy
FlowFieldSpaceStrategy ..> Session : 생성
FlowFieldManager --> Session
Session --> IFlowFieldSpaceBuilder
FlowFieldSurfaceBuilder ..|> IFlowFieldSpaceBuilder
FlowFieldVolumeBuilder ..|> IFlowFieldSpaceBuilder
FlowFieldBuildScheduler --> Session : Pump(예산)
Session --> FlowFieldExecutionBoundary
Editor ..> FlowFieldManager : CaptureConfig
Editor ..> FlowFieldSpaceStrategy : 검증·격자
Editor ..> Session : 직접 Pump
@enduml

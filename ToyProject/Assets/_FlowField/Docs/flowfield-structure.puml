@startuml flowfield-structure
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName "Apple SD Gothic Neo"
skinparam defaultFontSize 15
skinparam ArrowColor #496A88
skinparam Padding 6
skinparam classBackgroundColor #EEF5FB
skinparam classBorderColor #496A88
hide empty members
hide circle
title FlowField 구조

class "IFlowFieldController\n: IFlowFieldProvider" as API <<interface>>
class FlowFieldManager {
  설정 묶음
  FlowFieldManagerConfig
  FlowFieldModifierAttachment
}
class FlowFieldExecutionBoundary
class FlowFieldBuildDriver
class FlowFieldBuildScheduler
interface IFlowFieldBuildOperation
class "FlowFieldSession\n(공통 파이프라인)" as Session {
  수명·이벤트·빌드 루프
  FlowFieldFailures
}
interface IFlowFieldSpaceBuilder
class "FlowFieldSurfaceBuilder (Surface2D)" as Surface {
  SurfaceBaseStage
  SurfaceSolveStage
  SurfaceComposeStage
  SurfaceFieldStore
}
class "FlowFieldVolumeBuilder (Volume3D)" as Volume {
  VolumeObstacleTracker
  VolumeModifierRegistry
  VolumeBuildContext
  VolumeSafetyState
}
class "FlowFieldField·FlowFieldSampler\nFlowFieldSafety" as Shared
class "FlowFieldDynamicObstacle\nFlowFieldGoalTarget\nModifier Volume" as Components

FlowFieldManager .up.|> API
FlowFieldManager --> Session
FlowFieldManager --> FlowFieldExecutionBoundary
Components ..> API : 통지
Session --> IFlowFieldSpaceBuilder
Surface ..|> IFlowFieldSpaceBuilder
Volume ..|> IFlowFieldSpaceBuilder
Surface --> Shared
Volume --> Shared
Session --> FlowFieldExecutionBoundary
Session ..|> IFlowFieldBuildOperation
FlowFieldBuildScheduler --> IFlowFieldBuildOperation
FlowFieldBuildDriver -right-> FlowFieldBuildScheduler
@enduml

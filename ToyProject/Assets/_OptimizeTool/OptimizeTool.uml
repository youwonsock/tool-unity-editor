@startuml

!pragma layout smetana
left to right direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 28
skinparam ranksep 36
hide empty members

package "Common.OptimizeTool.MeshOptimization\n(Runtime)" as MeshRuntime {
  class MeshCombiner {
    +LastBuildWarnings
    settings, scene output state
  }

  class BackfaceCullMeshBaker {
    settings
  }
}

package "Common.OptimizeTool.MeshOptimization.Editor" as MeshEditor {
  class MeshToolCommands <<static>> {
    +BuildMeshes(this MeshCombiner)
    +CombineAndSaveMeshes(this MeshCombiner)
    +BakeBackFaceCullingMesh(this BackfaceCullMeshBaker)
  }
  class MeshBuildPipeline <<static>>
  class MeshAssetTransaction <<static>>
}

package "Common.OptimizeTool.PhysicsRecording\n(Runtime)" as PhysicsRuntime {
  class PhysicsRecorder {
    +IsRecording
    +StartRecording(duration, animName)
    +StopRecording() : PhysicsRecordingResult
    +CancelRecording()
    +Result : PhysicsRecordingResult
  }
  interface IPhysicsRecordingExporter
  class PhysicsTake
  class PhysicsRecordingReference
}

package "Common.OptimizeTool.PhysicsRecording.Editor" as PhysicsEditor {
  class PhysicsRecordingEditorExporter <<InitializeOnLoad>>
  class PhysicsRecordingAssetWriter <<static>>
  class PhysicsClipBuilder <<static>>
}

package "Common.OptimizeTool.Editor\n(shared)" as SharedEditor {
  class AssetFileTransaction <<static>>
}

MeshToolCommands ..> MeshCombiner : reads settings
MeshToolCommands ..> BackfaceCullMeshBaker : reads settings
MeshToolCommands --> MeshBuildPipeline : builds
MeshToolCommands --> MeshAssetTransaction : saves
MeshAssetTransaction --> AssetFileTransaction : paths / rollback

PhysicsRecorder --> PhysicsTake : captures steps
PhysicsRecorder --> IPhysicsRecordingExporter : validate / export
PhysicsRecordingEditorExporter ..|> IPhysicsRecordingExporter
PhysicsRecordingEditorExporter --> PhysicsRecordingAssetWriter
PhysicsRecordingAssetWriter --> PhysicsClipBuilder : reduces keys
PhysicsRecordingAssetWriter --> PhysicsRecordingReference : optional
PhysicsRecordingAssetWriter --> AssetFileTransaction : saves

note bottom of SharedEditor
Mesh optimization and the physics recorder never reference each other.
Copy Script/Shared plus one system folder to move that system.
end note

@enduml

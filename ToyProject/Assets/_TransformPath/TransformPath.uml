@startuml

left to right direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 28
skinparam ranksep 36
hide empty members

package "Provider" {
  interface IPathProvider {
    +IsReady
    +Revision
    +PathLength
    +Sample(normalizedTime)
    +SampleDistance(distance)
  }

  interface IPathMovementProvider {
    +MovementSettings
  }

  interface IPathSequenceProvider {
    +SegmentCount
    +GetSegment(index)
    +GetSegmentLength(index)
  }

  interface IPathEventSource {
    +EventCount
    +GetEvent(index)
  }

  class PathData {
    +Init()
    +Rebuild()
    +Sample(normalizedTime)
  }

  class MultiPathData {
    +Init()
    +Rebuild()
    +ConfigureSegments(descriptors)
  }
}

package "Playback" {
  interface IPathFollower {
    +State
    +StartPlayback(request)
    +PauseMove()
    +Seek(time)
    +SetSpeed(value)
    +Init()
  }

  class PathFollower {
    +Init()
    +StartPlayback(request)
    +PauseMove()
    +ResumeMove()
    +Seek(time)
  }

  class PathPlaybackEngine {
    +PlaybackId
    +StateRevision
  }

  class PathPlaybackSession {
    +ProviderRevision
    +MovementSettings
    +EventCursor
  }

  class PathRuntimeDriver {
    +Register(tickable)
    +Unregister(tickable)
    +Tick(delta, unscaledDelta, frame)
  }
}

package "Events" {
  class PathEventHandler {
    +Init()
    +Release()
    +HandleEvent(setting)
  }

  class PathEventRuntime {
    +ResolveIntent(definition, state)
    +ApplyLifecycle(intent, follower)
  }

  class PathEventScheduler {
    +Schedule(event, follower)
    +Advance(delta, frame)
  }

  class PathTimeScaleCoordinator {
    +Request(owner, target, duration)
    +Release(owner)
  }

  interface IPathEventReceiver {
    +ReceivePathEvent(name, state)
  }
}

package "Queue" {
  interface IQueuedPathAgent {
    +PlaybackId
    +QueueProvider
    +QueueSettings
    +ApplyQueueState(state)
    +OnQueueDetached(reason)
  }

  interface IPathConstraintTarget {
    +AttachQueueConstraint(registration)
    +ApplyQueueConstraint(constraint)
    +ReleaseQueueConstraint(registration)
  }

  class QueuedPathFollower {
    +StartPlayback(request)
    +PauseMove()
    +ResumeMove()
    +ForceBlock()
  }

  class QueuedPathManager {
    +AgentCount
    +Register(agent)
    +Unregister(registration)
    +ConfigureRoute(provider)
  }

  class PathQueueCoordinator {
    +GetSpacing(agent)
    +CalculateSpeedMultiplier(agent, distance, spacing)
  }
}

IPathProvider <|-- IPathMovementProvider
IPathProvider <|-- IPathSequenceProvider
IPathProvider <|.. PathData
IPathMovementProvider <|.. PathData
IPathEventSource <|.. PathData
IPathProvider <|.. MultiPathData
IPathSequenceProvider <|.. MultiPathData

IPathFollower <|.. PathFollower
IPathFollower <|.. QueuedPathFollower
PathFollower *-- PathPlaybackEngine
PathFollower *-- PathPlaybackSession
PathPlaybackSession --> IPathProvider : snapshot
PathRuntimeDriver ..> PathFollower : frame tick
PathRuntimeDriver ..> PathEventHandler : ordered step

PathFollower --> PathEventHandler : dispatches events
PathEventHandler *-- PathEventRuntime
PathEventHandler *-- PathEventScheduler
PathEventHandler --> IPathFollower : reads and controls
PathEventHandler --> IPathEventReceiver : notifies
PathEventHandler --> PathTimeScaleCoordinator : owns time request

IQueuedPathAgent <|.. QueuedPathFollower
IPathConstraintTarget <|.. PathFollower
QueuedPathFollower --> PathFollower : delegates commands
QueuedPathFollower --> IPathConstraintTarget : delivers constraint
QueuedPathManager o-- IQueuedPathAgent : registrations
QueuedPathManager *-- PathQueueCoordinator
QueuedPathManager --> IPathProvider : shared route
PathQueueCoordinator --> IQueuedPathAgent : reads progress/settings

note right of IPathFollower
State, playback, movement and lifecycle
roles are split into source contracts;
the overview keeps their public facade here.
end note

note bottom of IPathEventSource
Runtime event definitions and their
authoring ScriptableObjects are omitted
from this overview.
end note

note bottom of IQueuedPathAgent
Registration and constraint DTOs are
carried by the contract but omitted as
separate nodes for readability.
end note

@enduml

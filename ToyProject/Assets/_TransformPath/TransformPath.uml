@startuml
!pragma layout elk
left to right direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
hide empty members

package "Provider" {
  interface IPathProvider
  interface IPathMovementProvider
  interface IPathSequenceProvider
  interface IPathEventSource
  class PathData
  class MultiPathData
  class PathGeometryUtility <<static>>
}

package "Playback" {
  interface IPathPlaybackState
  interface IPathFollower {
    +Init() / Release()
    +StartPlayback(request)
    +StopMove() / PauseMove() / ResumeMove()
    +Seek(progress) / SeekSegment(index, local)
    +SetSpeed(speed) / SetDuration(duration)
  }
  interface IPathPlaybackIdentity <<internal>>
  class PathPlaybackRequest <<value>>
  class PathCommandReceipt <<value>>
  class PathFollower {
    -PlaybackId / StateRevision
    -queue constraint
    +StartPlayback(request)
    +StopMove() / Release()
    -HasReachedSegmentEnd(length)
    ~PreparePlayback(request) : PathPlaybackSession
    ~StartPreparedPlayback(request, session)
    -SeekTo(segment, local)
  }
  class PathPlaybackSession {
    +ProviderRevision
    +MovementSettings
    +NextEventIndex
    +EvaluateRefresh()
  }
  class PathSequenceSnapshot
  class PathProgressCalculator <<static>>
}

package "Frame execution" {
  interface IPathRuntimeTickable <<internal>>
  interface IPathRuntimeFaultHandler <<internal>>
  class PathRuntimeDriverBehaviour
  class PathRuntimeDriver {
    -frame records: List<FrameEntry>
    -active registration versions
    +Register(item) / Unregister(item)
    +Tick(delta, unscaledDelta, frame)
  }
}

package "Events" {
  interface IPathEventReceiver
  interface IPathTimeScaleStore <<internal>>
  class PathEventSettingSO <<authoring>>
  class PathEventDefinition <<immutable>> {
    +FromAuthoring(setting)
    ~AreSame(left, right)
  }
  class PathRuntimeEvent <<value>> {
    ~SortByPosition(events)
    ~AreSame(left, right)
  }
  class PathEventSourceSnapshot
  class PathEventHandler
  class PathEventRuntime <<static>>
  class PathEventDefinitionValidator <<static>>
  class PathEventScheduler
  class PathScalarAdjustment
  class PathTimeScaleCoordinator
  class UnityPathTimeScaleStore
}

package "Queue" {
  interface IQueuedPathAgent
  interface IPathConstraintTarget
  class QueuedPathFollower {
    -nullable manager result
    -notification revision
    +StartQueuedPlayback(manager, request)
    +StartFreePlayback(request)
    +DetachQueue()
    -TryRegisterWithManager()
  }
  class PathQueueSession {
    -registration / constraint owner
    -hold / resume delay / smoothing
    +TryAcquire() / Release()
    +Step()
  }
  class QueuedPathManager {
    -QueueEntry: agent + token + nullable state
    -frame snapshot / provider identities
    +Register(agent) / Unregister(token)
    +ConfigureRoute(provider)
    +Release()
  }
  class PathQueueCoordinator <<static>>
  class PathQueueRegistration <<value>> {
    +RegistrationId / PlaybackId
    +RouteRevision : at acquisition
  }
  class PathQueueState <<value>>
  class PathQueueConstraint <<value>> {
    +RouteRevision : calculation version
    +FrameId
  }
}

IPathProvider <|-- IPathMovementProvider
IPathProvider <|-- IPathSequenceProvider
IPathMovementProvider <|.. PathData
IPathEventSource <|.. PathData
IPathSequenceProvider <|.. MultiPathData
MultiPathData o-- IPathProvider : ordered children
PathData ..> PathGeometryUtility : builds geometry
PathData ..> PathRuntimeEvent : publishes ordered events
PathEventDefinition ..> PathEventSettingSO : copies authoring data
PathRuntimeEvent --> PathEventDefinition

IPathPlaybackState <|-- IPathFollower
IPathFollower <|.. PathFollower
IPathFollower <|.. QueuedPathFollower
IPathPlaybackIdentity <|.. PathFollower
IPathPlaybackIdentity <|.. QueuedPathFollower
PathFollower ..> PathPlaybackRequest
PathFollower ..> PathCommandReceipt
PathFollower *-- PathPlaybackSession
PathPlaybackSession --> IPathProvider
PathPlaybackSession *-- PathSequenceSnapshot
PathPlaybackSession *-- PathEventSourceSnapshot
PathSequenceSnapshot *-- PathEventSourceSnapshot
IPathEventSource <|.. PathEventSourceSnapshot
PathEventSourceSnapshot ..> PathRuntimeEvent : shared ordering / equality
PathFollower ..> PathProgressCalculator

PathRuntimeDriverBehaviour *-- PathRuntimeDriver
PathRuntimeDriver o-- IPathRuntimeTickable : frame records
PathRuntimeDriver ..> IPathRuntimeFaultHandler : original execution fault
IPathRuntimeTickable <|.. PathEventHandler
IPathRuntimeTickable <|.. QueuedPathManager
IPathRuntimeTickable <|.. QueuedPathFollower
IPathRuntimeTickable <|.. PathFollower
IPathRuntimeFaultHandler <|.. PathEventHandler
IPathRuntimeFaultHandler <|.. QueuedPathManager
IPathRuntimeFaultHandler <|.. QueuedPathFollower
IPathRuntimeFaultHandler <|.. PathFollower

PathFollower --> PathEventHandler : crossed events / cleanup
PathEventHandler ..> PathEventRuntime : intent / lifecycle
PathEventHandler ..> PathEventDefinitionValidator
PathEventHandler *-- PathEventScheduler
PathEventHandler *-- PathScalarAdjustment
PathEventHandler --> IPathEventReceiver : notifies
PathEventHandler --> IPathFollower : commands
PathEventHandler --> PathTimeScaleCoordinator : shared ownership
PathTimeScaleCoordinator --> IPathTimeScaleStore
IPathTimeScaleStore <|.. UnityPathTimeScaleStore

IQueuedPathAgent <|.. QueuedPathFollower
IPathConstraintTarget <|.. PathFollower
QueuedPathFollower --> PathFollower : delegates playback
QueuedPathFollower ..> PathPlaybackSession : local prepared candidate
QueuedPathFollower *-- PathQueueSession
PathQueueSession --> QueuedPathManager : registration lifetime
PathQueueSession --> IPathConstraintTarget : constraint ownership
PathQueueSession --> PathQueueRegistration
QueuedPathManager o-- IQueuedPathAgent : active entries
QueuedPathManager ..> PathQueueCoordinator : pure spacing / slowdown math
QueuedPathManager --> IPathProvider : route structure identities
QueuedPathManager ..> PathQueueState : publishes per frame
QueuedPathFollower ..> PathQueueConstraint : applies smoothed result
QueuedPathFollower --> IPathConstraintTarget

note bottom of PathRuntimeDriver
Frame order: EventHandler (-200), QueueManager (-180),
QueuedFollower (-110), PathFollower (-100).
Playback ID and registration version reject stale work.
end note

note bottom of QueuedPathManager
Detach batches survive nested Release calls.
Registration conditions are checked again after callbacks.
Geometry refresh preserves registration ownership.
Each agent snapshot is checked directly against the route revision.
end note

note bottom of PathFollower
Start/Pause/Resume apply animator state before notifications.
After a callback, check execution identity before continuing.
Queue completion and invalidation use the same notification guard.
Constraints must match the current provider revision and frame order.
Completion checks use the current duration after events.
Changed Seek/SeekSegment end the old tick and clear its remaining time.
No-op Seek keeps the tick. PlaybackId is preserved.
Start reuses a local prepared session; changed providers are revalidated.
end note

note bottom of QueuedPathFollower
Moving replacements reconcile the underlying PlaybackId
with queue ownership before applying constraints.
Mismatched routes or released managers invalidate participation.
Paused state is owned by the follower, without a second pause flag.
Queue commands end the previous notification batch without
changing the public playback StateRevision.
end note
@enduml

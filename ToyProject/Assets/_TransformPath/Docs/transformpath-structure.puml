@startuml transformpath-structure
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName "Apple SD Gothic Neo"
skinparam defaultFontSize 15
skinparam ArrowColor #496A88
skinparam Padding 6
skinparam classBackgroundColor #EEF5FB
skinparam classBorderColor #496A88
hide empty members
hide circle
title TransformPath 구조

interface IPathProvider
class PathProviderBehaviour <<abstract>>
class "PathData\nMultiPathData" as Providers
class PathPolyline
class PathRoute
class PathRuntimeDriver
class PathRuntimeBehaviour <<abstract>>
class PathFollower
class PathPlayback {
  PathPlaybackCursor
  값 보간, 지연 이벤트
  PathMotionLimit
}
class PathEventDefinition
class QueuedPathManager
class PathQueueMember
class PathQueueCoordinator <<static>>
class PathExecutionBoundary <<static>>

PathProviderBehaviour .up.|> IPathProvider
Providers -up-|> PathProviderBehaviour
Providers --> PathPolyline : PathData
PathProviderBehaviour --> PathRoute : 리비전별 캐시
PathRoute --> PathEventDefinition
PathFollower -up-|> PathRuntimeBehaviour
QueuedPathManager -up-|> PathRuntimeBehaviour
PathFollower *--> PathPlayback
PathPlayback --> PathRoute
PathQueueMember --> PathFollower : 제한 기록
QueuedPathManager --> PathQueueMember : 결과 전달
QueuedPathManager --> PathQueueCoordinator
PathRuntimeDriver --> PathRuntimeBehaviour : 효과 → Queue → 이동
PathPlayback ..> PathExecutionBoundary : 알림
PathQueueMember ..> PathExecutionBoundary : 알림
@enduml
